{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roboverify.dev/schemas/ir/asset.schema.json",
  "title": "Asset IR",
  "description": "Engineering asset model (Asset Registry entry). Every error parameter MUST carry a provenance level; import fails otherwise (ADR-0004).",
  "type": "object",
  "required": ["schemaVersion", "id", "category", "model", "params"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "id": { "type": "string", "pattern": "^asset-[0-9A-Za-z._-]+$" },
    "category": { "enum": ["robot", "camera", "gripper", "force_sensor", "controller", "compute"] },
    "vendor": { "type": "string" },
    "model": { "type": "string" },
    "cost_cny": { "type": "number" },
    "discontinued": { "type": "boolean", "default": false },
    "params": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "value", "provenance"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "examples": [
              "dof", "reach_mm", "payload_kg", "repeatability_mm", "absolute_accuracy_mm", "max_tcp_speed_mm_s", "controller_latency_ms",
              "resolution", "fps", "fov_deg", "range_mm", "interface", "latency_ms", "depth_sigma_mm", "depth_available",
              "grip_force_n", "stroke_mm", "control_latency_ms"
            ]
          },
          "value": { "type": ["number", "string", "boolean", "object"] },
          "unit": { "type": "string" },
          "provenance": { "enum": ["datasheet", "literature", "measured", "calibrated"] },
          "sourceRef": { "type": "string", "description": "datasheet page / paper DOI / test report id" },
          "conditions": { "type": "object", "description": "conditions under which the value holds, e.g. {distance_mm: 700, lux: 1000}" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
