{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roboverify.dev/schemas/ir/task.schema.json",
  "title": "Task IR",
  "description": "The task to be accomplished. V0.1 scope: PickObject only.",
  "type": "object",
  "required": ["schemaVersion", "id", "type", "target", "successCriteria"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "id": { "type": "string" },
    "type": { "enum": ["PickObject", "PlaceObject", "InspectObject"] },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "partRef": { "type": "string", "description": "reference to Environment IR parts[].name" },
        "destination": { "type": "string" },
        "throughput_per_hour": { "type": "number" }
      }
    },
    "preconditions": { "type": "array", "items": { "type": "string" } },
    "successCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "description": "requirement ids, e.g. R001" }
    },
    "failureCriteria": { "type": "array", "items": { "type": "string" } },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "examples": ["max_tcp_speed", "max_accel", "damage_free"] },
          "value": { "type": ["number", "string", "boolean"] },
          "unit": { "type": "string" }
        }
      }
    }
  }
}
