{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roboverify.dev/schemas/ir/experiment.schema.json",
  "title": "Experiment IR",
  "description": "Defines the experiment space and sampling strategy. M3 scope: LHS + Monte Carlo.",
  "type": "object",
  "required": ["schemaVersion", "id", "parameters", "sampling"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "id": { "type": "string" },
    "projectId": { "type": ["string", "null"] },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "distribution"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "examples": ["illumination_lux", "occlusion_percent", "depth_noise_mm", "object_size_mm", "network_latency_ms", "friction_coeff"] },
          "distribution": { "enum": ["uniform", "normal", "loguniform", "choice"] },
          "range": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number" },
            "description": "[min, max] for uniform/loguniform"
          },
          "mean": { "type": "number" },
          "sigma": { "type": "number" },
          "values": { "type": "array", "items": {}, "description": "option list for choice" },
          "unit": { "type": "string" }
        }
      }
    },
    "sampling": {
      "type": "object",
      "required": ["method", "n"],
      "additionalProperties": false,
      "properties": {
        "method": { "enum": ["lhs", "monte_carlo", "grid", "random"] },
        "n": { "type": "integer", "minimum": 1 },
        "seed": { "type": "integer" },
        "batch_size": { "type": "integer", "minimum": 1, "default": 50 }
      }
    },
    "aggregation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metric": { "type": "string" },
        "statistic": { "enum": ["mean", "P50", "P90", "P95", "success_rate"] }
      }
    }
  }
}
