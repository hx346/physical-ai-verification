{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roboverify.dev/schemas/ir/environment.schema.json",
  "title": "Environment IR",
  "description": "Physical working environment. Boundaries here seed the Experiment IR parameter space.",
  "type": "object",
  "required": ["schemaVersion", "id"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "id": { "type": "string" },
    "projectId": { "type": ["string", "null"] },
    "bin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width_mm": { "type": "number" }, "height_mm": { "type": "number" }, "depth_mm": { "type": "number" },
        "wall_thickness_mm": { "type": "number" },
        "material": { "type": "string" }
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "material"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "size_mm": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "min": { "type": "number" }, "max": { "type": "number" } }
          },
          "material": { "type": "string", "examples": ["steel", "aluminum", "plastic"] },
          "reflectivity": { "enum": ["matte", "semi", "reflective"] },
          "mass_g": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "min": { "type": "number" }, "max": { "type": "number" } }
          },
          "stack": { "enum": ["random", "ordered", "single_layer"] },
          "surface_coating": { "type": "string" }
        }
      }
    },
    "illumination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lux": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "min": { "type": "number" }, "max": { "type": "number" } }
        },
        "source": { "enum": ["natural", "led", "halogen", "mixed"] }
      }
    },
    "occlusion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "percent": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "min": { "type": "number", "maximum": 100 }, "max": { "type": "number", "maximum": 100 } }
        }
      }
    },
    "temperature_c": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "min": { "type": "number" }, "max": { "type": "number" } }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "latency_ms": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "min": { "type": "number" }, "max": { "type": "number" } }
        },
        "jitter_ms_max": { "type": "number" }
      }
    },
    "obstacles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "pose"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "shape": { "enum": ["box", "cylinder", "sphere"] },
          "dimensions": { "type": "object" },
          "pose": { "type": "object", "required": ["x", "y", "z"] }
        }
      }
    }
  }
}
