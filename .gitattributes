# Normalize line endings; keep repo consistent across Windows/Linux dev.
* text=auto

# Always LF
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.sql text eol=lf

# Always CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binaries
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.stl binary
*.dae binary
*.urdf text eol=lf
*.xacro text eol=lf
