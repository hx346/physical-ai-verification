# RoboVerify 部署环境变量示例（复制为 deploy/.env 后按需修改；.env 已被 gitignore）
#
# ---- 宿主端口（默认避免与本机服务冲突）----
FRONTEND_PORT=18000
BACKEND_PORT=18090
RUNTIME_PORT=18081
POSTGRES_PORT=15432
SEAWEED_S3_PORT=18333
SEAWEED_MASTER_PORT=19333

# ---- 对象存储切换（默认 local；启用 SeaweedFS 见 deploy/demo/verify-seaweedfs.sh）----
# ROBOVERIFY_STORAGE_TYPE=seaweed-s3
# ROBOVERIFY_S3_ENDPOINT=http://seaweedfs:8333
# ROBOVERIFY_S3_ACCESS_KEY=roboverify
# ROBOVERIFY_S3_SECRET_KEY=roboverify-secret
# ROBOVERIFY_S3_BUCKET=roboverify
